rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every read and write goes through the server API (Admin SDK bypasses
    // these rules). Workspaces, roles, plan limits, URL validation, password
    // hashing and click counting are enforced there, so clients get no direct access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
