# ──────────────────────────────────────────────────────────────────────
# Long Story Short — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit the .env file with real secrets!
# ──────────────────────────────────────────────────────────────────────

# ─── Firebase Web App (Client-Side) ─────────────────────────────────
# Get these from: Firebase Console > Project settings > Your apps
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ─── Application ────────────────────────────────────────────────────
VITE_APP_URL=https://loss.tr

# Optional: set this only if the API runs on a separate hostname.
# Leave empty when frontend and API share the same origin (e.g. Vercel).
# VITE_SHORTENER_API_URL=

# ─── Server-Only (Vercel Environment Variables) ─────────────────────
# Get these from: Firebase Console > Project settings > Service accounts
# > Generate new private key (downloads a JSON file)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# RECOMMENDED for Vercel: use base64-encoded private key (one-line, no escaping issues)
# To generate: base64 -w0 < service-account.json | pbcopy
FIREBASE_PRIVATE_KEY_BASE64=base64_encoded_private_key

# OR use the escaped-newline form for local development:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Short Link Configuration ───────────────────────────────────────
# Canonical host for short links (used as document ID prefix in Firestore)
SHORT_LINK_BASE_URL=https://loss.tr
SHORT_LINK_HOST=loss.tr

# CORS: only allow requests from this origin
FRONTEND_ORIGIN=https://loss.tr
