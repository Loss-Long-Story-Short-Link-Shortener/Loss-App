# Firebase Web app configuration
# Copy this file to .env.local and paste values from Firebase Console > Project settings > Your apps
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional: use a custom short-link API later. Firebase client secrets must never be placed here.
# Optional: add this only when the API is deployed on a separate hostname.
# VITE_SHORTENER_API_URL=https://api.consolaktif.com.tr
VITE_APP_URL=https://loss.consolaktif.com.tr

# Server-only Vercel environment variables. Do not prefix these with VITE_.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Recommended for Vercel: one-line base64 value. Use either this OR FIREBASE_PRIVATE_KEY.
FIREBASE_PRIVATE_KEY_BASE64=base64_encoded_private_key
# Local .env files may use the escaped-newline form instead:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
SHORT_LINK_BASE_URL=https://go.consolaktif.com.tr
SHORT_LINK_HOST=go.consolaktif.com.tr
FRONTEND_ORIGIN=https://loss.consolaktif.com.tr
