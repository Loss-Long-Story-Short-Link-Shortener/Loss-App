# ──────────────────────────────────────────────────────────────────────
# Long Story Short — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit the .env file with real secrets!
# ──────────────────────────────────────────────────────────────────────

# ─── Firebase Web App (Client-Side) ─────────────────────────────────
# Firebase Console > Project settings > Your apps
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ─── Application ────────────────────────────────────────────────────
VITE_APP_URL=https://loss.tr
# Only if the API runs on a different origin than the frontend (then also set FRONTEND_ORIGIN).
# VITE_SHORTENER_API_URL=

# ─── Server-only (Vercel Environment Variables) ─────────────────────
# Firebase Console > Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Recommended on Vercel: base64 of the private key (single line)
FIREBASE_PRIVATE_KEY_BASE64=base64_encoded_private_key
# or, for local development:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Short links ────────────────────────────────────────────────────
SHORT_LINK_BASE_URL=https://loss.tr
SHORT_LINK_HOST=loss.tr
# Comma-separated list of origins allowed to call the API cross-origin.
# Leave empty when the frontend and API share an origin (default on Vercel).
FRONTEND_ORIGIN=

# Secret used to derive the daily-rotating visitor hash. Generate with: openssl rand -hex 32
SALT_SECRET=

# ─── Billing (PayTR) ────────────────────────────────────────────────
# Without these, checkout returns 503 and the PayTR callback refuses requests.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# Set to 1 ONLY while testing; test-mode payments still upgrade the plan.
PAYTR_TEST_MODE=0
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>" to /api/billing/paytr-recurring.
# The endpoint refuses every request when this is empty. Generate with: openssl rand -hex 32
CRON_SECRET=

# ─── Platform features ──────────────────────────────────────────────
# Comma-separated Firebase UIDs allowed to use /api/admin (abuse moderation).
ADMIN_UIDS=
# Extra hostnames that should be treated as the main site (besides SHORT_LINK_HOST and *.vercel.app).
ALIAS_HOSTS=
# Optional: block these destination domains outright (comma separated).
BLOCKED_DOMAINS=
# Optional: Google Web Risk API key; destinations flagged as malware/phishing are rejected.
WEB_RISK_API_KEY=
# Optional: attach verified custom domains to your Vercel project automatically.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# CNAME target shown to customers for custom domains.
CUSTOM_DOMAIN_CNAME_TARGET=cname.vercel-dns.com
